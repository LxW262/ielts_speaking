{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the IELTS speaking app.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile picture URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was created."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Practice": {
      "title": "Practice",
      "description": "A generated IELTS speaking practice response.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who created this practice."
        },
        "question": {
          "type": "string",
          "description": "The IELTS question (optional)."
        },
        "topic": {
          "type": "string",
          "description": "The topic of the practice."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keywords or key phrases extracted from the response."
        },
        "part": {
          "type": "string",
          "enum": ["Part 1", "Part 2", "Part 3"],
          "description": "The part of the IELTS speaking test."
        },
        "chineseInput": {
          "type": "string",
          "description": "The user's original Chinese input."
        },
        "englishResponse": {
          "type": "string",
          "description": "The AI-generated English response."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the practice was generated."
        }
      },
      "required": ["userId", "part", "englishResponse", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profiles."
    },
    "/practices/{practiceId}": {
      "schema": {
        "$ref": "#/entities/Practice"
      },
      "description": "User's IELTS speaking practices."
    }
  }
}
